pragma cashscript ^0.10.0;

// JackpotVault: Smart Contract for BingoPlus Satoshi Platform Reserves
contract JackpotVault(pubkey houseOwner, pubkey adminTwo) {

    // Function to release jackpot payout with 2-of-2 admin approval
    function releasePayout(sig ownerSig, sig adminSig) {
        require(checkSig(ownerSig, houseOwner));
        require(checkSig(adminSig, adminTwo));
    }

    // Function to reclaim funds back to primary house wallet after 30 days timelock
    function reclaim(sig ownerSig, int lockTime) {
        require(checkSig(ownerSig, houseOwner));
        require(tx.time >= lockTime);
    }
}
